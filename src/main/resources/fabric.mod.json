{
  "schemaVersion": 1,
  "id": "shield_view_disabler",
  "version": "${version}",
  "name": "Shield view disabler",
  "description": "This mod makes the shield invisible when it is not currently blocking. And also, when activated, mod makes shield much smaller, so, it's no longer blocks half of the screen.",
  "authors": ["Evga314"],
  "contact": {

    "homepage": "https://t.me/Evga314mods",
    "sources": "https://github.com/Evga314/shield-view-disabler",
    "issues": "https://github.com/Evga314/shield-view-disabler/issues"
  },
  "license": "MIT",
  "icon": "assets/shield_view_disabler/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "com.Evga314.shield_view_disabler.client.Shield_view_disablerDataGenerator"
    ],
    "client": [
      "com.Evga314.shield_view_disabler.client.Shield_view_disablerClient"
    ],
    "main": [
      "com.Evga314.shield_view_disabler.Shield_view_disabler"
    ]
  },
  "mixins": [
    "shield_view_disabler.mixins.json",
    {
      "config": "shield_view_disabler.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
